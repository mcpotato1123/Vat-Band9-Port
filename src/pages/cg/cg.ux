<template>
  <div class="page">
    <text class="title">CG 鉴赏</text>
    <text class="sub">{{total}} 张 · 已全部解锁</text>

    <div class="grid">
      <div class="cell" for="{{cells}}" style="left: {{$item.left}}px; top: {{$item.top}}px;" onclick="openGroup($idx)">
        <image class="thumb" src="{{$item.thumb}}"></image>
        <text class="cap">{{$item.cap}}</text>
        <text class="cnt">{{$item.cnt}}</text>
      </div>
    </div>

    <div class="pager">
      <text class="pg" onclick="prev">‹</text>
      <text class="pnum">{{page + 1}} / {{pages}}</text>
      <text class="pg" onclick="next">›</text>
    </div>

    <div class="backbtn" onclick="home">
      <text class="back-t">返回标题</text>
    </div>

    <!-- viewer: full-width CG, drag horizontally to see all of it -->
    <div class="viewer" if="{{viewer}}">
      <div class="vclip">
        <image class="big" src="{{bigSrc}}" style="left: {{bigLeft}}px;"
               ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd"
               ontouchcancel="onTouchEnd" onswipe="onSwipe"></image>
        <div class="vclose" onclick="closeViewer">
          <text class="vc-t">×</text>
        </div>
      </div>
      <text class="vhint" if="{{panRange > 0}}">← 拖动查看全图 →</text>
      <text class="vbtn vprev" onclick="prevImg">‹</text>
      <text class="vpos">{{imgPos + 1}} / {{imgCount}}</text>
      <text class="vbtn vnext" onclick="nextImg">›</text>
    </div>
  </div>
</template>

<style>
.page { width: 336px; height: 480px; background-color: #141512; flex-direction: column; }
.title { margin-left: 18px; margin-top: 12px; font-size: 22px; color: #eeeadd; }
.sub { margin-left: 18px; margin-top: 2px; font-size: 11px; color: #a4a48e; }

.grid { position: absolute; left: 0; top: 64px; width: 336px; height: 300px; }
.cell { position: absolute; width: 156px; height: 132px; background-color: #24251f; }
.thumb { position: absolute; left: 0; top: 0; width: 156px; height: 88px; }
.cap { position: absolute; left: 6px; top: 92px; width: 100px; font-size: 12px; color: #eeeadd; }
.cnt { position: absolute; left: 106px; top: 93px; width: 44px; text-align: right; font-size: 11px; color: #b8ac8b; }

.pager { position: absolute; left: 0; top: 384px; width: 336px; height: 26px; flex-direction: row; justify-content: center; align-items: center; }
.pg { width: 56px; text-align: center; font-size: 20px; color: #d1cbb6; }
.pnum { width: 90px; text-align: center; font-size: 12px; color: #b8ac8b; }
.backbtn { position: absolute; left: 98px; top: 424px; width: 140px; height: 40px; background-color: #2c2e26; border-width: 1px; border-style: solid; border-color: #eb6877; border-radius: 12px; justify-content: center; align-items: center; }
.back-t { font-size: 18px; color: #f7dfce; }

.viewer { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #000000; flex-direction: column; }
.vclip { position: relative; width: 336px; height: 300px; overflow: hidden; }
.big { position: absolute; top: 0; width: 533px; height: 300px; }
.vhint { width: 336px; text-align: center; margin-top: 8px; font-size: 12px; color: #8f8681; }
.vclose { position: absolute; right: 10px; top: 10px; width: 58px; height: 58px; border-radius: 29px; background-color: rgba(12, 10, 12, 0.78); border-width: 1px; border-style: solid; border-color: #eb6877; border-radius: 12px; justify-content: center; align-items: center; }
.vc-t { font-size: 32px; color: #f7dfce; }
.vbtn { position: absolute; top: 330px; width: 70px; height: 56px; text-align: center; font-size: 28px; color: #d1cbb6; }
.vprev { left: 22px; }
.vnext { left: 244px; }
.vpos { position: absolute; left: 92px; top: 344px; width: 152px; text-align: center; font-size: 14px; color: #b8ac8b; }
</style>

<script>
import router from '@system.router'
import { IMG } from '../../common/assets.js'

const BIG_W = 533
const VIEW_W = 336
const MAX_LEFT = 0
const MIN_LEFT = VIEW_W - BIG_W

export default {
  protected: {
    cells: [],
    page: 0,
    pages: 1,
    total: 0,
    viewer: false,
    bigSrc: '',
    bigLeft: MIN_LEFT / 2,
    panRange: 0,
    imgPos: 0,
    imgCount: 0
  },

  onInit() {
    this.groups = []
    this.cur = []
    this.lockTap = 0
    this.build()
  },

  build() {
    const map = {}
    const order = []
    for (let i = 0; i < IMG.length; i++) {
      if (IMG[i].k !== 'cg') continue
      const name = IMG[i].n || ''
      const key = name.replace(/[ _]\d+$/, '').replace(/_\d+$/, '')
      if (!map[key]) { map[key] = []; order.push(key) }
      map[key].push(i)
    }
    this.total = 0
    this.groups = []
    for (let k = 0; k < order.length; k++) {
      const imgs = map[order[k]]
      this.total += imgs.length
      this.groups.push({ key: order[k], imgs: imgs })
    }
    this.pages = Math.max(1, Math.ceil(this.groups.length / 4))
    this.refresh()
  },

  refresh() {
    const out = []
    const base = this.page * 4
    for (let i = 0; i < 4; i++) {
      const g = this.groups[base + i]
      if (!g) break
      out.push({
        cap: g.key,
        cnt: g.imgs.length + ' 张',
        thumb: IMG[g.imgs[0]].t || IMG[g.imgs[0]].p,
        left: 8 + (i % 2) * 160,
        top: ((i - i % 2) / 2) * 140
      })
    }
    this.cells = out
  },

  prev() { if (this.page > 0) { this.page--; this.refresh() } },
  next() { if (this.page < this.pages - 1) { this.page++; this.refresh() } },

  openGroup(i) {
    if (this.lockTap && Date.now() - this.lockTap < 400) return
    this.lockTap = Date.now()
    const g = this.groups[this.page * 4 + i]
    if (!g) return
    this.cur = g.imgs
    this.imgCount = this.cur.length
    this.imgPos = 0
    this.showImage()
    this.viewer = true
  },

  showImage() {
    const e = IMG[this.cur[this.imgPos]]
    this.bigSrc = e.g || e.p
    this.panRange = BIG_W - VIEW_W
    this.bigLeft = -this.panRange / 2
  },

  onTouchStart(e) {
    this.dragX = this.readX(e)
    this.dragFrom = this.bigLeft
    this.dragging = true
  },

  onTouchMove(e) {
    if (!this.dragging) return
    const x = this.readX(e)
    if (x === null || this.dragX === null) return
    let left = this.dragFrom + (x - this.dragX)
    if (left > MAX_LEFT) left = MAX_LEFT
    if (left < MIN_LEFT) left = MIN_LEFT
    this.bigLeft = left
  },

  onTouchEnd() {
    this.dragging = false
  },

  onSwipe(e) {
    let dir = e && e.direction
    if (!dir && e && e.detail) dir = e.detail.direction
    const step = 90
    if (dir === 'left') this.bigLeft = Math.max(MIN_LEFT, this.bigLeft - step)
    if (dir === 'right') this.bigLeft = Math.min(MAX_LEFT, this.bigLeft + step)
  },

  readX(e) {
    if (!e) return null
    const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]) || e
    if (t.clientX !== undefined) return t.clientX
    if (t.pageX !== undefined) return t.pageX
    if (t.x !== undefined) return t.x
    if (t.offsetX !== undefined) return t.offsetX
    return null
  },

  prevImg() {
    if (this.imgPos > 0) { this.imgPos--; this.showImage() }
  },

  nextImg() {
    if (this.imgPos < this.cur.length - 1) { this.imgPos++; this.showImage() }
  },

  closeViewer() {
    this.viewer = false
    this.dragging = false
  },

  home() { router.replace({ uri: 'pages/index' }) }
}
</script>
